# SIGA-UBS production environment template.
# Copy to .env.prd and replace every placeholder before deploying.
#
# Usage:
#   cp .env.prd.example .env.prd
#   docker compose --env-file .env.prd -f docker-compose-prd.yml up -d --build

# -----------------------------------------------------------------------------
# Docker Compose ports
# -----------------------------------------------------------------------------
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Database
# If SPRING_DATASOURCE_USERNAME=root, keep SPRING_DATASOURCE_PASSWORD equal to
# MYSQL_ROOT_PASSWORD.
# -----------------------------------------------------------------------------
MYSQL_DATABASE=sigaubs
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# Spring
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prd

# -----------------------------------------------------------------------------
# Multi-tenant production domain
# https://afogados.sigaubs.com.br
# -----------------------------------------------------------------------------
SIGAUBS_TENANCY_BASE_DOMAIN=sigaubs.com.br
