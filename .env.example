# SIGA-UBS local development environment template.
# Do not put real production secrets in this file.
#
# Usage:
#   cp .env.example .env
#   docker compose -f docker-compose-dev.yml up --build

# -----------------------------------------------------------------------------
# Docker Compose ports
# -----------------------------------------------------------------------------
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
MYSQL_PORT=3306

# -----------------------------------------------------------------------------
# Database
# If SPRING_DATASOURCE_USERNAME=root, keep SPRING_DATASOURCE_PASSWORD equal to
# MYSQL_ROOT_PASSWORD.
# -----------------------------------------------------------------------------
MYSQL_DATABASE=sigaubs
MYSQL_ROOT_PASSWORD=root
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# -----------------------------------------------------------------------------
# Spring
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# Multi-tenant
# localhost -> http://afogados.localhost
# -----------------------------------------------------------------------------
SIGAUBS_TENANCY_BASE_DOMAIN=localhost

# -----------------------------------------------------------------------------
# Optional bootstrap script values
# -----------------------------------------------------------------------------
BOOTSTRAP_TENANT_SLUG=afogados
BOOTSTRAP_TENANT_NAME=Afogados da Ingazeira
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@sigaubs.local
