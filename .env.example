# SIGA-UBS local development environment template.
# Do not put real production secrets in this file.
#
# Usage:
#   cp .env.example .env
#   docker compose -f docker-compose-dev.yml up --build

# -----------------------------------------------------------------------------
# Docker Compose ports
# -----------------------------------------------------------------------------
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
# Porta do host usada somente pelo Compose de produção, vinculada a 127.0.0.1
# para acesso administrativo via túnel SSH.
MYSQL_HOST_PORT=3306

# -----------------------------------------------------------------------------
# Database. A aplicação usa uma conta distinta de root.
# -----------------------------------------------------------------------------
MYSQL_DATABASE=sigaubs
MYSQL_ROOT_PASSWORD=root-dev-only
MYSQL_USER=sigaubs_app
MYSQL_PASSWORD=sigaubs_dev_only

# -----------------------------------------------------------------------------
# Spring
# -----------------------------------------------------------------------------
# O Compose define explicitamente o profile dev; não combine profiles.
SPRING_PROFILES_ACTIVE=dev
# Lease renovável do job; deve ser maior que a maior operação indivisível da rotina.
SIGAUBS_CONTEMPLATION_JOB_LEASE_DURATION=30m

# -----------------------------------------------------------------------------
# Multi-tenant
# localhost -> http://afogados.localhost
# -----------------------------------------------------------------------------
SIGAUBS_TENANCY_BASE_DOMAIN=localhost

# -----------------------------------------------------------------------------
# Optional bootstrap script values
# -----------------------------------------------------------------------------
BOOTSTRAP_TENANT_SLUG=afogados
BOOTSTRAP_TENANT_NAME=Afogados da Ingazeira
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@sigaubs.local
